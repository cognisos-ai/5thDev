{
  "description": "Opt-in, content-free Fabric Agent lifecycle observation for Codex.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex-lifecycle.cjs\" SessionStart",
            "timeout": 3,
            "statusMessage": "Observing Fabric Agent session lifecycle"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex-lifecycle.cjs\" PreCompact",
            "timeout": 3
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex-lifecycle.cjs\" PostCompact",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex-lifecycle.cjs\" SessionEnd",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
